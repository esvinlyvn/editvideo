   "start": 2.35,
   "end": 2.71,
   "speaker": "A",
   "text": "Đi!"
  },
  {
   "i": 3,
   "start": 2.956,
   "end": 3.625,
   "speaker": "B",
   "text": "Ăn gì?"
  },
  {
   "i": 4,
   "start": 4.002,
   "end": 4.802,
   "speaker": "A",
   "text": "Gì cũng được!"
  },
  {
   "i": 5,
   "start": 5.399,
   "end": 5.891,
   "speaker": "B",
   "text": "Cơm tấm?"
  },
  {
   "i": 6,
   "start": 6.677,
   "end": 7.869,
   "speaker": "A",
   "text": "Trưa mới ăn."
  },
  {
   "i": 7,
   "start": 8.261,
   "end": 8.813,
   "speaker": "B",
   "text": "Bún bò?"
  },
  {
   "i": 8,
   "start": 9.537,
   "end": 10.153,
   "speaker": "A",
   "text": "Nóng quá!"
  },
  {
   "i": 9,
   "start": 10.754,
   "end": 11.406,
   "speaker": "B",
   "text": "Sushi?"
  },
  {
   "i": 10,
   "start": 11.888,
   "end": 12.213,
   "speaker": "A",
   "text": "Mắc!"
  },
  {
   "i": 11,
   "start": 12.98,
   "end": 13.473,
   "speaker": "B",
   "text": "Lẩu?"
  },
  {
   "i": 12,
   "start": 13.768,
   "end": 14.986,
   "speaker": "A",
   "text": "Hai đứa ăn sao hết?"
  },
  {
   "i": 13,
   "start": 15.367,
   "end": 15.739,
   "speaker": "B",
   "text": "Thôi!"
  },
  {
   "i": 14,
   "start": 16.033,
   "end": 16.555,
   "speaker": "B",
   "text": "Vậy về!"
  },
  {
   "i": 15,
   "start": 16.982,
   "end": 18.12,
   "speaker": "A",
   "text": "Ủa? Đi ăn mà?"
  },
  {
   "i": 16,
   "start": 18.355,
   "end": 21.784,
   "speaker": "B",
   "text": "Chào mấy mày, tao là Sáu suy nghĩ đây!"
  },
  {
   "i": 17,
   "start": 22.374,
   "end": 23.352,
   "speaker": "B",
   "text": "Nhớ follow tao nha!"
