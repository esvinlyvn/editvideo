  {
   "i": 23,
   "start": 33.74,
   "end": 34.985,
   "speaker": "B",
   "text": "đáp án cũng không cho coi!"
  },
  {
   "i": 24,
   "start": 35.564,
   "end": 36.096,
   "speaker": "B",
   "text": "Nên lần sau,"
  },
  {
   "i": 25,
   "start": 36.436,
   "end": 37.186,
   "speaker": "B",
   "text": "tao đổi chiến thuật."
  },
  {
   "i": 26,
   "start": 37.746,
   "end": 39.169,
   "speaker": "B",
   "text": "Giữa cơm tấm với bún bò,"
  },
  {
   "i": 27,
   "start": 39.705,
   "end": 40.193,
   "speaker": "B",
   "text": "mày chọn món nào?"
  },
  {
   "i": 28,
   "start": 41.239,
   "end": 42.274,
   "speaker": "A",
   "text": "Có món thứ ba không?"
  },
  {
   "i": 29,
   "start": 42.682,
   "end": 43.251,
   "speaker": "B",
   "text": "Có!"
  },
  {
   "i": 30,
   "start": 43.508,
   "end": 44.263,
   "speaker": "B",
   "text": "Cơm nhà mày!"
  },
  {
   "i": 31,
   "start": 44.912,
   "end": 45.78,
   "speaker": "A",
   "text": "Thôi cơm tấm đi!"
  },
  {
   "i": 31.5,
   "start": 46.4,
   "end": 47.02,
   "speaker": "B",
   "text": "Đó!"
  },
  {
   "i": 32,
   "start": 47.2,
   "end": 48.868,
   "speaker": "B",
   "text": "Tự nhiên người ta quyết đoán hẳn!"
  },
  {
   "i": 33,
   "start": 49.26,
   "end": 50.055,
   "speaker": "B",
   "text": "Tưởng đi ăn tối,"
  },
  {
   "i": 34,
   "start": 50.384,
   "end": 52.723,
   "speaker": "B",
   "text": "ai dè phải thi tuyển vị trí trợ lý giám đốc!"
  }
 ]
