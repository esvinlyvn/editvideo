   "start": 23.953,
   "end": 25.387,
   "speaker": "B",
   "text": "Tao mới nhận ra một chuyện."
  },
  {
   "i": 19,
   "start": 25.863,
   "end": 27.335,
   "speaker": "B",
   "text": "Câu “ăn gì cũng được” thiệt ra không phải câu trả lời."
  },
  {
   "i": 20,
   "start": 27.839,
   "end": 28.886,
   "speaker": "B",
   "text": "Nó là một bài kiểm tra."
  },
  {
   "i": 21,
   "start": 29.422,
   "end": 31.551,
   "speaker": "B",
   "text": "Mày phải đoán đúng món người ta đang nghĩ trong đầu!"
  },
  {
   "i": 22,
   "start": 32.143,
   "end": 33.327,
   "speaker": "B",
   "text": "Mà đề thi thì không phát,"
