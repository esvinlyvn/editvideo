{
 "source": "align.mjs (local)",
 "chunks": [
  {
   "i": 0,
   "start": 0,
   "end": 1.254,
   "speaker": "B",
   "text": "Có một kiểu chia tay rất"
  },
  {
   "i": 1,
   "start": 1.509,
   "end": 1.98,
   "speaker": "B",
   "text": "kỳ lạ."
  },
  {
   "i": 2,
   "start": 2.655,
   "end": 4.504,
   "speaker": "B",
   "text": "Mày đã xóa người ta khỏi cuộc đời mình,"
  },
  {
   "i": 3,
   "start": 5.227,
   "end": 7.142,
   "speaker": "B",
   "text": "vậy mà tháng nào vẫn phải gửi tiền đều đều."
  },
  {
   "i": 4,
   "start": 8.024,
   "end": 9.261,
   "speaker": "B",
   "text": "Khoan, tao không nói người yêu cũ."
  },
  {
   "i": 5,
   "start": 9.87,
   "end": 12.085,
   "speaker": "B",
   "text": "Tao đang nói tới mấy cái ứng dụng trong điện thoại đó!"
  },
  {
   "i": 6,
   "start": 12.796,
   "end": 13.36,
   "speaker": "B",
   "text": "Ví dụ nha."
  },
  {
   "i": 7,
   "start": 14.053,
   "end": 15.271,
   "speaker": "B",
   "text": "Mày tải một cái app chỉnh ảnh,"
  },
  {
   "i": 8,
   "start": 16.103,
   "end": 17.713,
   "speaker": "B",
   "text": "thấy quảng cáo dùng thử miễn phí 7 ngày."
  },
  {
   "i": 9,
   "start": 18.72,
   "end": 19.405,
   "speaker": "B",
   "text": "Xài được một bữa,"
  },
  {
   "i": 10,
   "start": 19.669,
   "end": 20.096,
   "speaker": "B",
   "text": "thấy chán,"
  },
  {
   "i": 11,
   "start": 20.322,
   "end": 20.697,
   "speaker": "B",
   "text": "xóa luôn."
  },
  {
   "i": 12,
   "start": 21.602,
   "end": 22.287,
   "speaker": "B",
   "text": "Tưởng đâu xong chuyện?"
  },
  {
   "i": 13,
   "start": 22.947,
   "end": 24.113,
   "speaker": "B",
   "text": "Ai dè tháng sau, ting!"
  },
  {
   "i": 14,
   "start": 24.674,
   "end": 25.93,
   "speaker": "B",
   "text": "Tài khoản bị trừ 99 cá."
  },
  {
   "i": 15,
   "start": 26.65,
   "end": 27.151,
   "speaker": "B",
   "text": "Tháng sau nữa,"
  },
  {
   "i": 16,
   "start": 27.394,
   "end": 27.699,
   "speaker": "B",
   "text": "ting!"
  },
  {
   "i": 17,
   "start": 28.198,
   "end": 28.386,
   "speaker": "B",
   "text": "Ủa?"
  },
  {
   "i": 18,
   "start": 29.21,
   "end": 31.75,
   "speaker": "B",
   "text": "Tao đuổi mày khỏi điện thoại rồi mà mày còn đòi tiền cấp dưỡng nữa hả trời?"
  },
  {
   "i": 19,
   "start": 32.553,
   "end": 32.974,
   "speaker": "B",
   "text": "Chào mấy mày,"
  },
  {
   "i": 20,
   "start": 33.316,
   "end": 34.119,
   "speaker": "B",
   "text": "tao là Sáu Suy Nghĩ đây,"
  },
  {
   "i": 21,
   "start": 34.479,
   "end": 35.25,
   "speaker": "B",
   "text": "nhớ follow tao nha!"
  },
  {
   "i": 22,
   "start": 36.715,
   "end": 38.005,
   "speaker": "B",
   "text": "Có một chuyện nhiều người không để ý:"
  },
  {
   "i": 23,
   "start": 38.664,
   "end": 39.486,
   "speaker": "B",
   "text": "Xóa ứng dụng không"
  },
  {
   "i": 24,
   "start": 39.714,
   "end": 41.693,
   "speaker": "B",
   "text": "có nghĩa là đã hủy gói đăng ký trả phí!"
  },
  {
   "i": 25,
   "start": 42.705,
   "end": 43.817,
   "speaker": "B",
   "text": "Nếu gói còn tự gia hạn,"
  },
  {
   "i": 26,
   "start": 44.313,
   "end": 46.915,
   "speaker": "B",
   "text": "tiền vẫn có thể bị trừ dù mày chẳng mở ứng dụng lần nào."
  },
  {
   "i": 27,
   "start": 47.759,
   "end": 49.106,
   "speaker": "B",
   "text": "Giờ lấy điện thoại ra kiểm tra thử nè."
  },
  {
   "i": 28,
   "start": 50.061,
   "end": 50.699,
   "speaker": "B",
   "text": "Nếu xài iPhone,"
  },
  {
   "i": 29,
   "start": 50.966,
   "end": 51.4,
   "speaker": "B",
   "text": "vô Cài đặt,"
  },
  {
   "i": 30,
   "start": 51.952,
   "end": 52.646,
   "speaker": "B",
   "text": "bấm vô tên của mày,"
  },
  {
   "i": 31,
   "start": 52.984,
   "end": 53.536,
   "speaker": "B",
   "text": "chọn Đăng ký."
  },
  {
   "i": 32,
   "start": 54.337,
   "end": 55.785,
   "speaker": "B",
   "text": "Ở đây có danh sách các gói đăng ký."
  },
  {
   "i": 33,
   "start": 56.16,
   "end": 58.339,
   "speaker": "B",
   "text": "Cái nào còn hoạt động mà không xài nữa thì bấm vô,"
  },
  {
   "i": 34,
   "start": 58.649,
   "end": 59.507,
   "speaker": "B",
   "text": "chọn Hủy đăng ký."
  },
  {
   "i": 35,
   "start": 60.514,
   "end": 60.974,
   "speaker": "B",
   "text": "Còn Android,"
  },
  {
   "i": 36,
   "start": 61.439,
   "end": 62.118,
   "speaker": "B",
   "text": "mở CH Play,"
  },
  {
   "i": 37,
   "start": 62.665,
   "end": 63.349,
   "speaker": "B",
   "text": "bấm hình đại diện,"
  },
  {
   "i": 38,
   "start": 63.918,
   "end": 65.349,
   "speaker": "B",
   "text": "vô Thanh toán và gói thuê bao,"
  },
  {
   "i": 39,
   "start": 65.661,
   "end": 66.392,
   "speaker": "B",
   "text": "chọn Gói thuê bao."
  },
  {
   "i": 40,
   "start": 67.145,
   "end": 68.012,
   "speaker": "B",
   "text": "Thấy gói nào không cần"
  },
  {
   "i": 41,
   "start": 68.415,
   "end": 68.729,
   "speaker": "B",
   "text": "thì hủy."
  },
  {
   "i": 42,
   "start": 69.774,
   "end": 71.478,
   "speaker": "B",
   "text": "Nếu không thấy gói nào mà tiền vẫn bị trừ,"
  },
  {
   "i": 43,
   "start": 72.17,
   "end": 73.474,
   "speaker": "B",
   "text": "kiểm tra hóa đơn hoặc sao kê"
  },
  {
   "i": 44,
   "start": 73.794,
   "end": 75.663,
   "speaker": "B",
   "text": "để biết bên nào đang thu tiền rồi liên hệ họ."
  },
  {
   "i": 45,
   "start": 76.803,
   "end": 77.102,
   "speaker": "B",
   "text": "Đặc biệt,"
  },
  {
   "i": 46,
   "start": 77.769,
   "end": 78.749,
   "speaker": "B",
   "text": "mấy gói dùng thử miễn phí,"
  },
  {
   "i": 47,
   "start": 79.009,
   "end": 80.907,
   "speaker": "B",
   "text": "nhớ kiểm tra ngày hết hạn để hủy kịp lúc nếu"
  },
  {
   "i": 48,
   "start": 81.467,
   "end": 82.278,
   "speaker": "B",
   "text": "không muốn gia hạn."
  },
  {
   "i": 49,
   "start": 83.499,
   "end": 85.513,
   "speaker": "B",
   "text": "Chuyện tình cảm thì tao không dám chỉ mày cách chia tay."
  },
  {
   "i": 50,
   "start": 86.416,
   "end": 88.889,
   "speaker": "B",
   "text": "Chứ chia tay một cái app mà tháng nào cũng phải trả tiền..."
  },
  {
   "i": 51,
   "start": 89.714,
   "end": 89.989,
   "speaker": "B",
   "text": "Thì thôi,"
  },
  {
   "i": 52,
   "start": 90.318,
   "end": 90.889,
   "speaker": "B",
   "text": "để tao chỉ cho!"
  },
  {
   "i": 53,
   "start": 92.087,
   "end": 93.186,
   "speaker": "B",
   "text": "Đừng có nuôi người yêu cũ,"
  },
  {
   "i": 54,
   "start": 93.896,
   "end": 94.133,
   "speaker": "B",
   "text": "à lộn,"
  },
  {
   "i": 55,
   "start": 94.762,
   "end": 95.776,
   "speaker": "B",
   "text": "ứng dụng cũ nữa"
  },
  {
   "i": 56,
   "start": 96.034,
   "end": 96.481,
   "speaker": "B",
   "text": "mấy cha!"
  }
 ]
}