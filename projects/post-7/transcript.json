{
 "source": "align.mjs (local)",
 "chunks": [
  {
   "i": 0,
   "start": 0,
   "end": 0.761,
   "speaker": "A",
   "text": "Tối nay đi nhậu không?"
  },
  {
   "i": 1,
   "start": 1.41,
   "end": 1.767,
   "speaker": "B",
   "text": "Tao mệt."
  },
  {
   "i": 2,
   "start": 2.133,
   "end": 3.363,
   "speaker": "A",
   "text": "Mệt thì ngồi tí thôi."
  },
  {
   "i": 3,
   "start": 3.674,
   "end": 4.357,
   "speaker": "B",
   "text": "Tao hết tiền."
  },
  {
   "i": 4,
   "start": 4.878,
   "end": 5.552,
   "speaker": "A",
   "text": "Tao bao!"
  },
  {
   "i": 5,
   "start": 6.229,
   "end": 7.363,
   "speaker": "B",
   "text": "Mai tao phải dậy sớm."
  },
  {
   "i": 6,
   "start": 7.695,
   "end": 8.571,
   "speaker": "A",
   "text": "Vậy 9 giờ về!"
  },
  {
   "i": 7,
   "start": 8.949,
   "end": 13.83,
   "speaker": "B",
   "text": "Đù má, từ chối một bữa nhậu mà cảm giác như đang thương lượng hiệp định hòa bình."
  },
  {
   "i": 8,
   "start": 14.201,
   "end": 16.39,
   "speaker": "B",
   "text": "Nhưng mày để ý một chuyện không?"
  },
  {
   "i": 9,
   "start": 16.854,
   "end": 18.025,
   "speaker": "B",
   "text": "Cứ mỗi lần mày"
  },
  {
   "i": 10,
   "start": 18.214,
   "end": 19.396,
   "speaker": "B",
   "text": "đưa ra một lý do,"
  },
  {
   "i": 11,
   "start": 19.955,
   "end": 21.88,
   "speaker": "B",
   "text": "người ta lại nghĩ ra một cách giải quyết lý do đó."
  },
  {
   "i": 12,
   "start": 22.687,
   "end": 23.26,
   "speaker": "B",
   "text": "Mày bảo mệt,"
  },
  {
   "i": 13,
   "start": 23.674,
   "end": 24.754,
   "speaker": "B",
   "text": "người ta bảo ngồi chơi thôi."
  },
  {
   "i": 14,
   "start": 25.387,
   "end": 26.296,
   "speaker": "B",
   "text": "Mày bảo hết tiền,"
  },
  {
   "i": 15,
   "start": 26.654,
   "end": 27.39,
   "speaker": "B",
   "text": "người ta đòi bao."
  },
  {
   "i": 16,
   "start": 28.158,
   "end": 28.795,
   "speaker": "B",
   "text": "Mày bảo bận,"
  },
  {
   "i": 17,
   "start": 29.107,
   "end": 29.569,
   "speaker": "B",
   "text": "người ta hỏi"
  },
  {
   "i": 18,
   "start": 29.756,
   "end": 30.293,
   "speaker": "B",
   "text": "mấy giờ xong."
  },
  {
   "i": 19,
   "start": 31.258,
   "end": 31.78,
   "speaker": "B",
   "text": "Vô tình,"
  },
  {
   "i": 20,
   "start": 32.051,
   "end": 33.299,
   "speaker": "B",
   "text": "mày biến lời từ chối thành một bài toán"
  },
  {
   "i": 21,
   "start": 33.51,
   "end": 34.441,
   "speaker": "B",
   "text": "để người khác tìm cách giải."
  },
  {
   "i": 22,
   "start": 34.624,
   "end": 35.993,
   "speaker": "B",
   "text": "Lần sau thử đổi cách nói."
  },
  {
   "i": 23,
   "start": 37.057,
   "end": 37.496,
   "speaker": "B",
   "text": "Thay vì:"
  },
  {
   "i": 24,
   "start": 37.809,
   "end": 38.529,
   "speaker": "B",
   "text": "\"Tao mệt"
  },
  {
   "i": 25,
   "start": 39.207,
   "end": 39.62,
   "speaker": "B",
   "text": "quá,"
  },
  {
   "i": 26,
   "start": 40.362,
   "end": 41.665,
   "speaker": "B",
   "text": "chắc không đi được.\""
  },
  {
   "i": 27,
   "start": 42.296,
   "end": 42.682,
   "speaker": "B",
   "text": "Hãy nói:"
  },
  {
   "i": 28,
   "start": 43.463,
   "end": 44.179,
   "speaker": "B",
   "text": "\"Cảm ơn mày đã rủ,"
  },
  {
   "i": 29,
   "start": 44.63,
   "end": 45.662,
   "speaker": "B",
   "text": "nhưng tối nay tao không đi."
  },
  {
   "i": 30,
   "start": 46.179,
   "end": 46.834,
   "speaker": "B",
   "text": "Hẹn bữa khác nhé.\""
  },
  {
   "i": 31,
   "start": 47.734,
   "end": 49.066,
   "speaker": "B",
   "text": "Nếu người ta tiếp tục năn nỉ?"
  },
  {
   "i": 32,
   "start": 49.748,
   "end": 50.024,
   "speaker": "B",
   "text": "\"Ừ,"
  },
  {
   "i": 33,
   "start": 50.31,
   "end": 51.007,
   "speaker": "B",
   "text": "tao biết vui mà."
  },
  {
   "i": 34,
   "start": 51.584,
   "end": 52.729,
   "speaker": "B",
   "text": "Nhưng nay tao không tham gia đâu.\""
  },
  {
   "i": 35,
   "start": 53.342,
   "end": 53.549,
   "speaker": "B",
   "text": "Hết!"
  },
  {
   "i": 36,
   "start": 54.498,
   "end": 58.763,
   "speaker": "B",
   "text": "Không cần bịa thêm ba cuộc họp, hai đám giỗ với một người bà con từ nước ngoài mới về."
  },
  {
   "i": 37,
   "start": 59.527,
   "end": 59.874,
   "speaker": "B",
   "text": "Tất nhiên,"
  },
  {
   "i": 38,
   "start": 60.065,
   "end": 61.626,
   "speaker": "B",
   "text": "có những trường hợp mày nên giải thích rõ ràng."
  },
  {
   "i": 39,
   "start": 62.38,
   "end": 63.751,
   "speaker": "B",
   "text": "Nhưng với một lời mời thông thường,"
  },
  {
   "i": 40,
   "start": 64.197,
   "end": 68.317,
   "speaker": "B",
   "text": "mày không nhất thiết phải chứng minh rằng mình có lý do đủ chính đáng để từ chối."
  },
  {
   "i": 41,
   "start": 69.205,
   "end": 69.574,
   "speaker": "B",
   "text": "Nhớ nha."
  },
  {
   "i": 42,
   "start": 70.238,
   "end": 71.442,
   "speaker": "B",
   "text": "Đừng đưa cho người khác"
  },
  {
   "i": 43,
   "start": 71.635,
   "end": 72.729,
   "speaker": "B",
   "text": "một bài toán để giải,"
  },
  {
   "i": 44,
   "start": 73.198,
   "end": 74.042,
   "speaker": "B",
   "text": "khi thứ mày muốn nói"
  },
  {
   "i": 45,
   "start": 74.312,
   "end": 74.959,
   "speaker": "B",
   "text": "chỉ đơn giản là"
  },
  {
   "i": 46,
   "start": 75.178,
   "end": 75.723,
   "speaker": "B",
   "text": "một quyết định."
  }
 ]
}